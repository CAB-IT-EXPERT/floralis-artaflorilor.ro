Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
# Only the front controller serves files; source, exports, credentials and database stay private.
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [QSA,L]
</IfModule>
# These protections remain effective even when rewrite has not been enabled.
RedirectMatch 403 ^/(app|data|migrations|tools|scripts|tests|src|node_modules|under-construction|floralis-media-export|produse-media-din-csv[^/]*)(/|$)
<FilesMatch "(^\.|client_secret|backup.?code|\.sqlite|\.env|\.sql$|\.zip$|\.log$|\.json$|\.csv$|\.ps1$|\.py$|^(?!index\.php$).*\.php$)">
Require all denied
</FilesMatch>
